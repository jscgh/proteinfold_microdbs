#!/bin/bash
#PBS -N micron_trunc
#PBS -l walltime=12:00:00
#PBS -l mem=124GB
#PBS -l ncpus=16
#PBS -j oe
#PBS -o /srv/scratch/sbf/dbs/proteinfold_microdbs/micron_truncate_job.out

set -euo pipefail

cd /srv/scratch/sbf/dbs/proteinfold_microdbs

# Optional module setup. The truncation script also attempts loads internally.
module load hhsuite/3.3.0 >/dev/null 2>&1 || true
module load zstd >/dev/null 2>&1 || true

WORK_DIR="/srv/scratch/z5378336/inputs/test_inputs/work_dev/Mar-16"
SOURCE_DB_DIR="/srv/scratch/sbf/dbs/proteinfold_dbs"
MICRON_DIR="/srv/scratch/sbf/dbs/proteinfold_microdbs/proteinfold_microdbs/micron"
SAMPLES_CSV="/srv/scratch/z5378336/inputs/test_inputs/fulltest.csv"
N_PER_SAMPLE="4"
MAX_TOTAL="12"
LOG_FILE="/srv/scratch/sbf/dbs/proteinfold_microdbs/proteinfold_microdbs/micron/truncate_micron_from_sample_hits.log"
WINDOW_MIN="0"
COLABFOLD_N="12"
PARAMS_SOURCE_DIR="/srv/scratch/sbf/dbs/proteinfold_dbs/params"
BOLTZ_MOLS_KEEP="0"

scripts/truncate_micron_from_sample_hits.sh \
  "$WORK_DIR" \
  "$SOURCE_DB_DIR" \
  "$MICRON_DIR" \
  "$SAMPLES_CSV" \
  "$N_PER_SAMPLE" \
  "$MAX_TOTAL" \
  "$LOG_FILE" \
  "$WINDOW_MIN" \
  "$COLABFOLD_N" \
  "$PARAMS_SOURCE_DIR" \
  "$BOLTZ_MOLS_KEEP"
